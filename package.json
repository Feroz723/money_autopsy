{
  "name": "money-autopsy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:app": "vite build",
    "build:lib": "tsc --project tsconfig.build.json",
    "preview": "vite preview",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run",
    "verify:fixtures": "vitest run tests/fixture-verification.test.ts --reporter=verbose"
  },
  "dependencies": {
    "pdfjs-dist": "^6.2.108",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "fflate": "^0.8.3",
    "happy-dom": "^20.11.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^7.3.6",
    "vitest": "^3.1.1"
  }
}
